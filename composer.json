{
  "name": "softcreatr/php-mistral-ai-sdk",
  "description": "A PSR-17/PSR-18 compatible PHP SDK for the Mistral AI API.",
  "license": "ISC",
  "type": "library",
  "version": "4.0.0",
  "keywords": [
    "mistral",
    "ai",
    "llama",
    "artificial-intelligence",
    "machine-learning",
    "natural-language-processing",
    "nlp",
    "php",
    "sdk",
    "api-wrapper"
  ],
  "authors": [
    {
      "name": "Sascha Greuel",
      "email": "hello@1-2.dev"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.25",
    "guzzlehttp/guzzle": "^7.15.5 || ^8.2.0",
    "phpstan/phpstan": "^2.2.13",
    "phpunit/phpunit": "^10.5.64 || ^11.5.56 || ^12.5.35 || ^13.3.3",
    "vlucas/phpdotenv": "^5.7.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "SoftCreatR\\MistralAI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SoftCreatR\\MistralAI\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "phpcsf": "php-cs-fixer fix",
    "test": "phpunit"
  }
}
